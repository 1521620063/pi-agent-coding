{
  "name": "pi-agent-coding",
  "displayName": "PI Agent Coding",
  "description": "A native-feeling VS Code sidebar for your locally installed PI coding agent.",
  "version": "1.0.5",
  "publisher": "SilasPaul",
  "preview": false,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "keywords": [
    "pi",
    "ai",
    "agent",
    "coding-agent",
    "sidebar",
    "chat",
    "assistant",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1521620063/pi-agent-coding.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "bugs": {
    "url": "https://github.com/1521620063/pi-agent-coding/issues"
  },
  "homepage": "https://github.com/1521620063/pi-agent-coding#readme",
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PI executes tools in your workspace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:pi.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi",
          "title": "PI",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "pi": [
        {
          "type": "webview",
          "id": "pi.sidebar",
          "name": "PI"
        }
      ]
    },
    "commands": [
      {
        "command": "pi.open",
        "title": "PI: Open Sidebar"
      },
      {
        "command": "pi.attachSelection",
        "title": "PI: Attach Selection"
      },
      {
        "command": "pi.reconnect",
        "title": "PI: Reconnect"
      },
      {
        "command": "pi.attachFiles",
        "title": "PI: 添加到 PI"
      },
      {
        "command": "pi.cycleModel",
        "title": "PI: 轮换模型"
      },
      {
        "command": "pi.cycleThinking",
        "title": "PI: 轮换思考强度"
      }
    ],
    "keybindings": [
      {
        "command": "pi.cycleModel",
        "key": "alt+shift+m",
        "when": "focusedView == pi.sidebar"
      },
      {
        "command": "pi.cycleThinking",
        "key": "alt+shift+t",
        "when": "focusedView == pi.sidebar"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pi.attachFiles",
          "group": "navigation",
          "when": "resourceScheme == file && !explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "pi.attachSelection",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "PI",
      "properties": {
        "pi.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the installed PI executable or official launcher.",
          "scope": "machine"
        },
        "pi.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional Node.js executable used for PI JavaScript launchers.",
          "scope": "machine"
        },
        "pi.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000
        },
        "pi.startupTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000
        },
        "pi.shutdownTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:vscode": "node scripts/test-vscode.mjs",
    "test:webview": "npm run compile && node scripts/test-webview.mjs",
    "validate": "npm run check && npm test && npm run test:integration",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run validate && npm run compile"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "mocha": {
      "glob": "^14.0.2"
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3"
  },
  "volta": {
    "node": "24.22.3"
  }
}
